# wx-dsh-agent 企微审批机器人 systemd 单元
# 安装：cp wx-dsh-agent.service /etc/systemd/system/ && systemctl daemon-reload
#       systemctl enable --now wx-dsh-agent
# 前置：build-wx-dsh-agent.sh 已生成 /opt/wx-dsh-agent，且部署者已把 .env.example 复制
#       为 /opt/wx-dsh-agent/.env 并填写真实密钥；/opt/deepseek-harness 已 pnpm install。
[Unit]
Description=wx-dsh-agent 企微审批机器人
After=network.target

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/wx-dsh-agent
EnvironmentFile=/opt/wx-dsh-agent/.env
Environment=DSH_HOME=/opt/wx-dsh-agent
# 直接跑 node 入口而非 `pnpm dsh`：pnpm 包装下 SIGTERM 返回 143 会让 systemd 视作异常停止；
# DSH 优雅关闭（SIGTERM -> exit 0）只对 node 进程成立（profile-boot 实现）。
# WORKSPACE=/opt/deepseek-harness 需在部署前替换为该机实际仓库路径。
ExecStart=/opt/homebrew/bin/node --import tsx/esm /opt/deepseek-harness/apps/cli/src/bin.ts --profile wx-dsh
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
